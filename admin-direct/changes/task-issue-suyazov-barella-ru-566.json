      "type": "update_page",
      "page_id": 3328,
      "content": "<style>\n.barella-catalog{--bc-blue:#0b5fa5;--bc-blue-dark:#084a82;--bc-ink:#1c2733;--bc-muted:#5a6b7b;--bc-bg:#f4f7fa;--bc-line:#dce5ee;font-family:\"Segoe UI\",Roboto,\"Helvetica Neue\",Arial,sans-serif;font-size:16px;line-height:1.6;color:var(--bc-ink);}\n.barella-catalog *,.barella-catalog *::before,.barella-catalog *::after{box-sizing:border-box;}\n.barella-catalog__inner{max-width:1200px;margin:0 auto;padding:0 20px;}\n.barella-catalog__head{padding:40px 0 0;}\n.barella-catalog__title{margin:0 0 12px;font-size:32px;line-height:1.25;font-weight:700;color:var(--bc-ink);}\n.barella-catalog__lead{margin:0 0 32px;font-size:17px;line-height:1.6;color:var(--bc-muted);max-width:760px;}\n.barella-catalog__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:0 0 48px;padding:0;}\n.barella-catalog-card{display:flex;flex-direction:column;width:100%;margin:0;padding:0;background:#ffffff;border:1px solid var(--bc-line);border-radius:8px;overflow:hidden;text-decoration:none;color:inherit;transition:box-shadow 0.2s ease,transform 0.2s ease;}\n.barella-catalog-card:hover{box-shadow:0 10px 28px rgba(11,95,165,0.14);transform:translateY(-2px);}\n.barella-catalog-card:focus-visible{outline:3px solid var(--bc-blue);outline-offset:2px;}\n.barella-catalog-card:hover .barella-catalog-card__more,.barella-catalog-card:focus-visible .barella-catalog-card__more{color:var(--bc-blue-dark);text-decoration:underline;}\n.barella-catalog-card__cover{display:block;width:100%;aspect-ratio:4 / 3;overflow:hidden;background:var(--bc-bg);}\n.barella-catalog-card__cover img{display:block;width:100%;height:100%;object-fit:cover;}\n.barella-catalog-card__body{display:flex;flex-direction:column;flex:1 1 auto;padding:18px 20px 20px;}\n.barella-catalog-card__title{display:block;margin:0 0 6px;font-size:17px;font-weight:600;line-height:1.35;color:var(--bc-ink);}\n.barella-catalog-card__meta{display:block;margin:0;color:var(--bc-muted);font-size:14px;line-height:1.5;}\n.barella-catalog-card__more{display:inline-block;margin-top:auto;padding-top:12px;font-size:14px;font-weight:600;color:var(--bc-blue);}\n.barella-catalog__cta{margin:0 0 56px;padding:32px 28px;background:var(--bc-bg);border:1px solid var(--bc-line);border-radius:10px;text-align:center;}\n.barella-catalog__cta-title{margin:0 0 8px;font-size:24px;line-height:1.3;font-weight:700;color:var(--bc-ink);}\n.barella-catalog__cta-text{margin:0 auto 20px;font-size:16px;color:var(--bc-muted);max-width:640px;}\n.barella-catalog__cta-link{display:inline-block;background:var(--bc-blue);color:#ffffff;border-radius:6px;padding:13px 26px;font-size:16px;font-weight:600;text-decoration:none;transition:background 0.2s ease;}\n.barella-catalog__cta-link:hover{background:var(--bc-blue-dark);color:#ffffff;}\n@media (max-width:1099px){\n.barella-catalog__grid{grid-template-columns:repeat(2,minmax(0,1fr));}\n}\n@media (max-width:699px){\n.barella-catalog__grid{grid-template-columns:minmax(0,1fr);}\n.barella-catalog__head{padding-top:28px;}\n.barella-catalog__title{font-size:26px;}\n.barella-catalog__lead{font-size:16px;}\n}\n</style>\n<div class=\"barella-catalog\">\n  <div class=\"barella-catalog__inner\">\n    <div class=\"barella-catalog__head\">\n      <h1 class=\"barella-catalog__title\">Наши объекты</h1>\n      <p class=\"barella-catalog__lead\">Реализованные проекты Бареллы: производства, апарт-отели, жилые комплексы и энергообъекты.</p>\n    </div>\n    <div class=\"barella-catalog__grid\">\n      <a class=\"barella-catalog-card\" href=\"https://barella.pro/obekty/svetlana/\">\n        <span class=\"barella-catalog-card__cover\"><img src=\"https://barella.pro/wp-content/uploads/2026/08/svetlana-01.jpg\" alt=\"Вентиляция производственных помещений завода «Светлана» — фото 1\" loading=\"lazy\" /></span>\n        <span class=\"barella-catalog-card__body\">\n          <span class=\"barella-catalog-card__title\">Производственные помещения на территории завода «Светлана»</span>\n          <span class=\"barella-catalog-card__meta\">Санкт-Петербург · Вентиляция производственных помещений</span>\n          <span class=\"barella-catalog-card__more\">Подробнее об объекте</span>\n        </span>\n      </a>\n      <a class=\"barella-catalog-card\" href=\"https://barella.pro/obekty/oktyabrskaya-naberezhnaya/\">\n        <span class=\"barella-catalog-card__cover\"><img src=\"https://barella.pro/wp-content/uploads/2026/08/barella-02-oktyabrskaya-01.jpg\" alt=\"Вентиляция паркинга жилого дома на Октябрьской набережной — фото 1\" loading=\"lazy\" /></span>\n        <span class=\"barella-catalog-card__body\">\n          <span class=\"barella-catalog-card__title\">Многоквартирный дом со встроенно-пристроенными помещениями и встроенно-пристроенным многоэтажным гаражом (автостоянкой)</span>\n          <span class=\"barella-catalog-card__meta\">Санкт-Петербург · Вентиляция паркинга</span>\n          <span class=\"barella-catalog-card__more\">Подробнее об объекте</span>\n        </span>\n      </a>\n      <a class=\"barella-catalog-card\" href=\"https://barella.pro/obekty/vertical/\">\n        <span class=\"barella-catalog-card__cover\"><img src=\"https://barella.pro/wp-content/uploads/2026/08/barella-03-vertical-01.jpg\" alt=\"Вентиляция и кондиционирование апарт-отеля «VERTICAL» — фото 1\" loading=\"lazy\" /></span>\n        <span class=\"barella-catalog-card__body\">\n          <span class=\"barella-catalog-card__title\">Апарт-отель «VERTICAL»</span>\n          <span class=\"barella-catalog-card__meta\">Санкт-Петербург · Вентиляция и кондиционирование</span>\n          <span class=\"barella-catalog-card__more\">Подробнее об объекте</span>\n        </span>\n      </a>\n      <a class=\"barella-catalog-card\" href=\"https://barella.pro/obekty/kalyannyy-bar-nevskiy/\">\n        <span class=\"barella-catalog-card__cover\"><img src=\"https://barella.pro/wp-content/uploads/2026/08/barella-04-nevskiy-01.jpg\" alt=\"Вентиляция кальянного бара на Невском проспекте — фото 1\" loading=\"lazy\" /></span>\n        <span class=\"barella-catalog-card__body\">\n          <span class=\"barella-catalog-card__title\">Кальянный бар на Невском проспекте</span>\n          <span class=\"barella-catalog-card__meta\">Санкт-Петербург · Вентиляция и кондиционирование</span>\n          <span class=\"barella-catalog-card__more\">Подробнее об объекте</span>\n        </span>\n      </a>\n      <a class=\"barella-catalog-card\" href=\"https://barella.pro/obekty/retinoidy/\">\n        <span class=\"barella-catalog-card__cover\"><img src=\"https://barella.pro/wp-content/uploads/2026/08/barella-05-retinoidy-01.jpg\" alt=\"Вентиляция чистого помещения АО «Ретиноиды» — фото 1\" loading=\"lazy\" /></span>\n        <span class=\"barella-catalog-card__body\">\n          <span class=\"barella-catalog-card__title\">Производственное помещение АО «Ретиноиды»</span>\n          <span class=\"barella-catalog-card__meta\">Москва · Вентиляция чистого помещения</span>\n          <span class=\"barella-catalog-card__more\">Подробнее об объекте</span>\n        </span>\n      </a>\n      <a class=\"barella-catalog-card\" href=\"https://barella.pro/obekty/polisan-ampulnaya-liniya/\">\n        <span class=\"barella-catalog-card__cover\"><img src=\"https://barella.pro/wp-content/uploads/2026/08/barella-06-polisan-ampoule-01.jpg\" alt=\"Чистое помещение новой ампульной линии ПОЛИСАН — фото 1\" loading=\"lazy\" /></span>\n        <span class=\"barella-catalog-card__body\">\n          <span class=\"barella-catalog-card__title\">Чистое помещение для новой ампульной линии</span>\n          <span class=\"barella-catalog-card__meta\">Санкт-Петербург · Чистое помещение</span>\n          <span class=\"barella-catalog-card__more\">Подробнее об объекте</span>\n        </span>\n      </a>\n      <a class=\"barella-catalog-card\" href=\"https://barella.pro/obekty/pskov-proizvodstvennye-linii/\">\n        <span class=\"barella-catalog-card__cover\"><img src=\"https://barella.pro/wp-content/uploads/2026/08/barella-07-pskov-lines-01.jpg\" alt=\"Вентиляция производственных линий кабельного производства в Пскове — фото 1\" loading=\"lazy\" /></span>\n        <span class=\"barella-catalog-card__body\">\n          <span class=\"barella-catalog-card__title\">Кабельное производство в Пскове — производственные линии и покрасочная камера</span>\n          <span class=\"barella-catalog-card__meta\">Псков · Промышленная вентиляция</span>\n          <span class=\"barella-catalog-card__more\">Подробнее об объекте</span>\n        </span>\n      </a>\n      <a class=\"barella-catalog-card\" href=\"https://barella.pro/obekty/pskov-drobestruy-galvanika/\">\n        <span class=\"barella-catalog-card__cover\"><img src=\"https://barella.pro/wp-content/uploads/2026/08/barella-08-pskov-galvanic-01.jpg\" alt=\"Вентиляция дробеструйной камеры и цеха гальваники в Пскове — фото 1\" loading=\"lazy\" /></span>\n        <span class=\"barella-catalog-card__body\">\n          <span class=\"barella-catalog-card__title\">Кабельное производство в Пскове — дробеструйная камера и цех гальваники</span>\n          <span class=\"barella-catalog-card__meta\">Псков · Промышленная вентиляция</span>\n          <span class=\"barella-catalog-card__more\">Подробнее об объекте</span>\n        </span>\n      </a>\n      <a class=\"barella-catalog-card\" href=\"https://barella.pro/obekty/polisan-paketnaya-liniya/\">\n        <span class=\"barella-catalog-card__cover\"><img src=\"https://barella.pro/wp-content/uploads/2026/08/barella-09-polisan-package-01.jpg\" alt=\"Чистое помещение второй пакетной линии ПОЛИСАН — фото 1\" loading=\"lazy\" /></span>\n        <span class=\"barella-catalog-card__body\">\n          <span class=\"barella-catalog-card__title\">Чистое помещение для 2-й пакетной линии</span>\n          <span class=\"barella-catalog-card__meta\">Санкт-Петербург · Чистое помещение</span>\n          <span class=\"barella-catalog-card__more\">Подробнее об объекте</span>\n        </span>\n      </a>\n      <a class=\"barella-catalog-card\" href=\"https://barella.pro/obekty/rublevo-arkhangelskoe/\">\n        <span class=\"barella-catalog-card__cover\"><img src=\"https://barella.pro/wp-content/uploads/2026/08/barella-10-rublevo-arkhangelskoe-01.jpg\" alt=\"Инженерные системы энергоцентра «Рублево-Архангельское» — фото 1\" loading=\"lazy\" /></span>\n        <span class=\"barella-catalog-card__body\">\n          <span class=\"barella-catalog-card__title\">Энергоцентр для 1-й очереди комплексной застройки территории АО «Рублево-Архангельское»</span>\n          <span class=\"barella-catalog-card__meta\">Москва · Комплекс инженерных систем</span>\n          <span class=\"barella-catalog-card__more\">Подробнее об объекте</span>\n        </span>\n      </a>\n    </div>\n    <div class=\"barella-catalog__cta\">\n      <p class=\"barella-catalog__cta-title\">Давайте обсудим ваш проект</p>\n      <p class=\"barella-catalog__cta-text\">Покажем релевантные кейсы и предложим решение под ваш объект.</p>\n      <a class=\"barella-catalog__cta-link\" href=\"https://barella.pro/kontakty/#feedback-form\">Получить бесплатную консультацию</a>\n    </div>\n  </div>\n</div>"
    }
  ],
