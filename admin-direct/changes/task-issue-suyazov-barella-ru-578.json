      "content": "<style>\nhtml,body{overflow-x:hidden}\n.bk-contacts,.bk-contacts *{box-sizing:border-box}\n.bk-contacts{color:#202020;background:#fff;padding:18px 0 0}\n.bk-title{font-size:40px;line-height:1.15;font-weight:800;text-transform:uppercase;letter-spacing:.02em;margin:0 0 48px;color:#171717}\n.bk-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(360px,480px);gap:80px;align-items:start;padding-bottom:64px}\n.bk-info{padding-top:8px}\n.bk-row{display:grid;grid-template-columns:48px minmax(0,1fr);gap:18px;align-items:start;margin:0 0 30px}\n.bk-icon{width:46px;height:46px;border:1px solid #870001;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#870001}\n.bk-label{font-size:18px;line-height:1.35;font-weight:700;margin:0 0 7px;color:#171717}\n.bk-line{display:block;font-size:16px;line-height:1.65;color:#3d3d3d;margin:0}\n.bk-info a.bk-line{color:#870001;text-decoration:none}\n.bk-info a.bk-line:hover,.bk-info a.bk-line:focus{text-decoration:underline}\n.bk-form-card{width:100%;background:#fff;border:1px solid #eee;border-radius:4px;box-shadow:0 14px 42px rgba(35,25,25,.10);padding:42px 40px 36px}\n.bk-form-title{font-size:27px;line-height:1.2;font-weight:800;letter-spacing:.03em;margin:0 0 10px;color:#171717}\n.bk-form-sub{font-size:15px;line-height:1.55;color:#696969;margin:0 0 26px}\n.bk-form-card .custom-consult-form>.row{display:flex!important;flex-direction:column!important;margin:0!important;gap:0!important}\n.bk-form-card .custom-consult-form>.row>[class*=col-]{flex:0 0 100%!important;width:100%!important;max-width:100%!important;padding:0!important}\n.bk-form-card .custom-consult-form>.row>[class*=col-]:nth-child(1){order:1}\n.bk-form-card .custom-consult-form>.row>[class*=col-]:nth-child(2){order:2}\n.bk-form-card .custom-consult-form>.row>[class*=col-]:nth-child(3){order:4}\n.bk-form-card .custom-consult-form>.row>[class*=col-]:nth-child(4){order:3}\n.bk-form-card .frm-control,.bk-form-card .frm-control p{margin:0!important}\n.bk-form-card .custom-consult-form>.row>[class*=col-]:nth-child(1),.bk-form-card .custom-consult-form>.row>[class*=col-]:nth-child(2){margin:0 0 15px!important}\n.bk-form-card .custom-consult-form>.row>[class*=col-]:nth-child(4){margin:2px 0 16px!important}\n.bk-form-card input.wpcf7-form-control:not([type=checkbox]){display:block;width:100%!important;height:52px;box-sizing:border-box;padding:13px 15px!important;border:1px solid #d9d9d9!important;border-radius:2px!important;font-size:15px;background:#fff!important;color:#202020!important;box-shadow:none!important}\n.bk-form-card input.wpcf7-form-control:not([type=checkbox]):focus{border-color:#870001!important;outline:none}\n.bk-form-card button.theme-btn{display:block!important;width:100%!important;min-height:52px;box-sizing:border-box;background:#870001!important;color:#fff!important;border:1px solid #870001!important;border-radius:2px!important;padding:14px 20px!important;font-size:15px;font-weight:700;line-height:1.35;cursor:pointer;text-align:center;box-shadow:none!important}\n.bk-form-card button.theme-btn:hover,.bk-form-card button.theme-btn:focus{background:#6d0001!important;border-color:#6d0001!important;color:#fff!important}\n.bk-form-card .consent-box,.bk-form-card .consent-box p{font-size:12px!important;line-height:1.45!important;color:#666!important}\n.bk-form-card .consent-box a{color:#870001!important}\n.bk-form-card .consent-box input[type=checkbox]{accent-color:#870001}\n.bk-form-card .wpcf7-response-output{font-size:13px;margin:16px 0 0!important}\n.bk-map{position:relative;left:50%;right:50%;width:100vw;max-width:100vw;margin:0 -50vw;background:#eee;overflow:hidden}\n.bk-map iframe{display:block;width:100%!important;max-width:none!important;height:400px!important;border:0!important;margin:0!important}\n@media(max-width:991px){.bk-title{margin-bottom:34px}.bk-layout{grid-template-columns:1fr;gap:38px;padding-bottom:48px}.bk-form-card{max-width:620px}.bk-map iframe{height:360px!important}}\n@media(max-width:600px){.bk-contacts{padding-top:6px}.bk-title{font-size:29px;margin-bottom:28px}.bk-layout{gap:26px;padding-bottom:36px}.bk-row{grid-template-columns:40px minmax(0,1fr);gap:13px;margin-bottom:22px}.bk-icon{width:40px;height:40px}.bk-label{font-size:16px}.bk-line{font-size:15px;line-height:1.55}.bk-form-card{min-width:0;padding:27px 20px 24px}.bk-form-title{font-size:22px}.bk-form-sub{margin-bottom:20px}.bk-map iframe{height:300px!important}}\n</style>\n<div class=\"bk-contacts\">\n<h1 class=\"bk-title\">Контакты</h1>\n<div class=\"bk-layout\">\n<div class=\"bk-info\">\n<div class=\"bk-row\"><div class=\"bk-icon\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 1 1 18 0z\"/><circle cx=\"12\" cy=\"10\" r=\"3\"/></svg></div><div><p class=\"bk-label\">Адрес:</p><span class=\"bk-line\">г. Санкт-Петербург, Полюстровский пр. 59 литера А</span><span class=\"bk-line\">Москва, Варшавское шоссе, 1с1-2</span></div></div>\n<div class=\"bk-row\"><div class=\"bk-icon\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.08 4.18 2 2 0 0 1 4.06 2h3a2 2 0 0 1 2 1.72c.12.9.34 1.78.66 2.62a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.46-1.18a2 2 0 0 1 2.11-.45c.84.32 1.72.54 2.62.66A2 2 0 0 1 22 16.92z\"/></svg></div><div><p class=\"bk-label\">Телефон:</p><a class=\"bk-line\" href=\"tel:+79214164646\">+7 (921) 416-46-46</a><a class=\"bk-line\" href=\"tel:+78129513015\">+7 (812) 951-30-15</a></div></div>\n<div class=\"bk-row\"><div class=\"bk-icon\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"4\"/><path d=\"M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8\"/></svg></div><div><p class=\"bk-label\">E-mail:</p><a class=\"bk-line\" href=\"mailto:info@barella.ru\">info@barella.ru</a></div></div>\n<div class=\"bk-row\"><div class=\"bk-icon\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><path d=\"M14 2v6h6\"/><path d=\"M12 18v-6\"/><path d=\"M9 15l3 3 3-3\"/></svg></div><div><p class=\"bk-label\">Реквизиты:</p><a class=\"bk-line\" href=\"https://barella.ru/wp-content/uploads/2023/09/rekvizty-ooo-barella.pdf\" target=\"_blank\" rel=\"noopener\">Скачать</a></div></div>\n</div>\n<div class=\"bk-form-card\"><h2 class=\"bk-form-title\">ОСТАВЬТЕ ЗАЯВКУ</h2><p class=\"bk-form-sub\">и мы перезвоним вам в кратчайшее время и проконсультируем по всем вашим вопросам</p>[contact-form-7 id=\"845\"]</div>\n</div>\n<div class=\"bk-map\"><iframe src=\"https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d7986.273982966323!2d30.370815322739567!3d59.97248095620905!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x469633cdfca3786d%3A0x55fe82c73c8a4844!2z0J_QvtC70Y7RgdGC0YDQvtCy0YHQutC40Lkg0L_RgC4sIDU50LAsINCh0LDQvdC60YIt0J_QtdGC0LXRgNCx0YPRgNCzLCAxOTUxOTc!5e0!3m2!1sru!2sru!4v1703651911731!5m2!1sru!2sru\" allowfullscreen=\"\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" title=\"Карта: Санкт-Петербург, Полюстровский пр. 59\"></iframe></div>\n</div>"
