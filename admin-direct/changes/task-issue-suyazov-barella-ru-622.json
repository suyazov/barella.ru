      "content": "<style>\nhtml,body{overflow-x:hidden}\n.blog-style-two.sec-pad:has(.bf-grid){padding-top:26px}\n.bf-grid{display:grid;gap:24px;margin:28px 0 0}\n.bf-grid-3{grid-template-columns:repeat(3,1fr)}\n.bf-grid-2{grid-template-columns:repeat(2,1fr)}\n.bf-grid-4{grid-template-columns:repeat(4,1fr)}\n.bf-card{background:#f7f7f7;border:1px solid #e4e4e4;border-radius:14px;padding:22px;box-shadow:0 1px 3px rgba(0,0,0,.06)}\n.bf-card h3,.bf-card h4{margin-top:0}\n.bf-num{font-size:40px;font-weight:700;color:#870001;line-height:1.1}\n.bf-list{padding-left:20px}\n.bf-list li{margin-bottom:8px}\n.blog-style-two:has(.bf-grid) .text>h2{margin-top:72px;margin-bottom:24px}\n.blog-style-two:has(.bf-grid) .text>h2:first-of-type{margin-top:0}\n.bf-note{color:#777;font-size:13px}\n.bf-check li{list-style:none;margin-bottom:14px;padding-left:4px}\n.bf-page-title{font-size:40px;line-height:1.2;font-weight:700;margin:0 0 16px;color:#171717}.bf-cta{width:100%;max-width:1160px;background:#f7f7f7;color:#202020;border:1px solid #e4e4e4;border-top:4px solid #870001;border-radius:14px;padding:24px 32px 20px!important;margin:64px 0 32px;text-align:left;box-shadow:0 8px 24px rgba(0,0,0,.08);box-sizing:border-box;height:auto!important;min-height:0!important}\n.blog-style-two .text:has(>.bf-cta),.blog-style-two:has(.bf-cta) .text{height:auto!important;min-height:0!important}\n.bf-cta h2{color:#171717;font-size:26px;line-height:1.25;font-weight:700;margin:0 0 8px!important}\n.bf-cta>p{max-width:720px;margin:0 0 14px!important}\n.bf-cta .wpcf7{width:100%;max-width:none!important;margin:0!important;padding:0!important;height:auto!important;min-height:0!important}\n.bf-cta .wpcf7-form{margin:0!important;padding:0!important;height:auto!important;min-height:0!important}\n.bf-cta .custom-consult-form,.bf-cta .custom-consult-form>.row,.bf-cta .custom-consult-form>.row>[class*=col-]{height:auto!important;min-height:0!important}\n.bf-cta .custom-consult-form>.row{display:grid!important;grid-template-columns:minmax(0,1fr) minmax(0,1fr) auto;gap:0 12px;margin:0!important;padding:0!important}\n.bf-cta .custom-consult-form>.row>[class*=col-]{flex:none!important;width:auto!important;max-width:none!important;padding:0!important;margin:0!important}\n.bf-cta .custom-consult-form>.row>[class*=col-]:nth-child(1){grid-column:1;grid-row:1}\n.bf-cta .custom-consult-form>.row>[class*=col-]:nth-child(2){grid-column:2;grid-row:1}\n.bf-cta .custom-consult-form>.row>[class*=col-]:nth-child(4){grid-column:3;grid-row:1}\n.bf-cta .custom-consult-form>.row>[class*=col-]:nth-child(3){grid-column:1/-1;grid-row:2;margin-top:10px!important}\n.bf-cta .frm-control,.bf-cta .frm-control p{margin:0!important}\n.bf-cta input.wpcf7-form-control:not([type=checkbox]){display:block;width:100%!important;height:44px!important;min-height:0!important;box-sizing:border-box;padding:10px 14px!important;border:1px solid #d9d9d9!important;border-radius:6px!important;font-size:15px;background:#fff!important;color:#202020!important;box-shadow:none!important}\n.bf-cta input.wpcf7-form-control:not([type=checkbox]):focus{border-color:#870001!important;outline:none}\n.bf-cta button.theme-btn{display:inline-flex!important;width:auto!important;height:44px!important;min-height:0!important;align-items:center;justify-content:center;background:#870001!important;color:#fff!important;border:1px solid #870001!important;border-radius:8px!important;padding:0 24px!important;font-size:14px;font-weight:700;letter-spacing:.02em;line-height:1.25;box-shadow:none!important;white-space:nowrap}\n.bf-cta button.theme-btn:hover,.bf-cta button.theme-btn:focus{background:#6d0001!important;border-color:#6d0001!important;color:#fff!important}\n.bf-cta .consent-box,.bf-cta .consent-box p{font-size:12px!important;line-height:1.45!important;color:#666!important;text-align:left}\n.bf-cta .consent-box a{color:#870001!important}\n.bf-cta .consent-box input[type=checkbox]{accent-color:#870001}\n.bf-cta .wpcf7-response-output{font-size:13px;margin:0!important}\n.bf-cta .wpcf7-response-output:not(:empty){margin:10px 0 0!important}\n@media(max-width:899px){.bf-cta .custom-consult-form>.row{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px 12px}\n.bf-cta .custom-consult-form>.row>[class*=col-]:nth-child(4){grid-column:1;grid-row:2}\n.bf-cta .custom-consult-form>.row>[class*=col-]:nth-child(3){grid-column:1/-1;grid-row:3;margin-top:0!important}}\n@media(max-width:599px){.bf-cta{padding:22px 18px 18px!important}\n.bf-cta .custom-consult-form>.row{grid-template-columns:minmax(0,1fr);gap:12px}\n.bf-cta .custom-consult-form>.row>[class*=col-]:nth-child(1){grid-column:1;grid-row:1}\n.bf-cta .custom-consult-form>.row>[class*=col-]:nth-child(2){grid-column:1;grid-row:2}\n.bf-cta .custom-consult-form>.row>[class*=col-]:nth-child(3){grid-column:1;grid-row:3;margin-top:0!important}\n.bf-cta .custom-consult-form>.row>[class*=col-]:nth-child(4){grid-column:1;grid-row:4}\n.bf-cta button.theme-btn{width:100%!important}}\n@media(max-width:991px){.bf-grid-3,.bf-grid-4{grid-template-columns:repeat(2,1fr)}.blog-style-two:has(.bf-grid) .text>h2{margin-top:60px}.bf-cta{margin-top:68px}}\n@media(max-width:600px){.blog-style-two.sec-pad:has(.bf-grid){padding-top:18px}.bf-grid-3,.bf-grid-2,.bf-grid-4{grid-template-columns:1fr}.blog-style-two:has(.bf-grid) .text>h2{margin-top:48px;margin-bottom:18px}.bf-page-title{font-size:28px}.bf-cta{margin:48px 0 24px}}\n</style>\n<h1 class=\"bf-page-title\">О компании Барелла</h1>\n<p><strong>Проектирование, монтаж и обслуживание систем вентиляции, кондиционирования и отопления.</strong></p>\n<p>Барелла — это команда профильных инженеров и монтажников, которая с 2013 года реализует комплексные проекты по созданию инженерных систем любой сложности. Мы работаем по всей России и берём на себя полный цикл работ: от проектирования до поставки оборудования, монтажа, пуско-наладки и сервисного обслуживания.</p>\n<h2>Барелла в цифрах</h2>\n<div class=\"bf-grid bf-grid-3\">\n<div class=\"bf-card\">\n<div class=\"bf-num\">13</div>\n<p>лет на рынке инженерных систем</p>\n</div>\n<div class=\"bf-card\">\n<div class=\"bf-num\">100%</div>\n<p>собственных монтажных бригад — без случайных субподрядчиков</p>\n</div>\n<div class=\"bf-card\">\n<div class=\"bf-num\">3</div>\n<p>года официальной гарантии на монтажные работы</p>\n</div>\n</div>\n<h2>Реализованные проекты</h2>\n<h3>Производственные и промышленные объекты</h3>\n<ul class=\"bf-list\">\n<li><strong>Завод «Светлана»</strong> (Санкт-Петербург) — поставка и монтаж систем вентиляции, кондиционирования и увлажнения производственных и административных помещений. Оборудование: Ruck, Domekt, Carel, Lessar.</li>\n<li><strong>АО «Ретиноиды»</strong> (Москва) — монтаж системы вентиляции и кондиционирования чистого помещения. Приточно-вытяжная установка с системой охлаждения в гигиеническом исполнении.</li>\n<li><strong>Кабельное производство</strong> (Псков) — комплекс работ по устройству систем вентиляции и местных отсосов производственных линий, покрасочной и дробеструйной камер, цеха гальваники.</li>\n</ul>\n<h3>Фармацевтика и медицинские учреждения</h3>\n<ul class=\"bf-list\">\n<li><strong>ООО «НТФФ «ПОЛИСАН»</strong> (Санкт-Петербург) — монтаж систем вентиляции чистых помещений для ампульной и пакетной линий производственного корпуса. Сборка и монтаж центральных кондиционеров в медицинском исполнении, системы воздуховодов и трубопроводов тепло-, холодо- и пароснабжения.</li>\n</ul>\n<h3>Коммерческая недвижимость и гостиничный бизнес</h3>\n<ul class=\"bf-list\">\n<li><strong>Апарт-отель «VERTICAL»</strong> (Санкт-Петербург) — монтаж систем вентиляции и кондиционирования. Общеобменная и противодымная вентиляция паркинга и цокольного этажа, четыре ВРВ-системы кондиционирования (107 внутренних блоков), настенные и кассетные сплит-системы.</li>\n<li><strong>Кальянный бар на Невском проспекте</strong> (Санкт-Петербург) — монтаж систем вентиляции и кондиционирования на базе центральных кондиционеров.</li>\n</ul>\n<h3>Жилое строительство и инфраструктура</h3>\n<ul class=\"bf-list\">\n<li><strong>Многоквартирный дом с паркингом</strong> (Санкт-Петербург, Октябрьская набережная) — монтаж систем общеобменной и противодымной вентиляции в вентиляционных шахтах и помещениях паркинга.</li>\n<li><strong>Энергоцентр для комплексной застройки «Рублево-Архангельское»</strong> (Москва) — монтаж полного комплекса инженерных сетей: вентиляция, кондиционирование, отопление, водоснабжение, канализация, электрические сети и автоматические системы управления.</li>\n</ul>\n<h2>Мы специализируемся на трёх ключевых направлениях</h2>\n<div class=\"bf-grid bf-grid-3\">\n<div class=\"bf-card\">\n<h3>Вентиляция</h3>\n<ul class=\"bf-list\">\n<li>Проектирование приточно-вытяжных систем любой сложности</li>\n<li>Монтаж общеобменной, противодымной и аварийной вентиляции</li>\n<li>Системы местных отсосов для производств</li>\n<li>Аспирация и пылеудаление</li>\n<li>Чистые помещения для фармацевтики и медицины</li>\n</ul>\n</div>\n<div class=\"bf-card\">\n<h3>Кондиционирование</h3>\n<ul class=\"bf-list\">\n<li>Центральные кондиционеры</li>\n<li>Мультизональные VRF/VRV системы</li>\n<li>Кассетные, канальные, настенные сплит-системы</li>\n<li>Увлажнение и осушение воздуха</li>\n<li>Системы чиллер-фанкойл</li>\n</ul>\n</div>\n<div class=\"bf-card\">\n<h3>Отопление</h3>\n<ul class=\"bf-list\">\n<li>Промышленное отопление</li>\n<li>Тепловые завесы и ИК-обогреватели</li>\n<li>Радиаторное отопление</li>\n<li>Тёплые полы</li>\n<li>Котельные под ключ</li>\n</ul>\n</div>\n</div>\n<h2>С какими объектами мы работаем</h2>\n<ul class=\"bf-list\">\n<li><strong>Производство и промышленность</strong> — вентиляция цехов, местные отсосы, аспирация, поддержание технологических параметров</li>\n<li><strong>Фармацевтика и медицина</strong> — чистые помещения, центральные кондиционеры в гигиеническом исполнении, соблюдение GMP</li>\n<li><strong>Общепит</strong> — проектирование строго по СанПиН, мощные вытяжные системы, жироулавливатели</li>\n<li><strong>Офисы и бизнес-центры</strong> — энергоэффективные решения, соблюдение норм охраны труда</li>\n<li><strong>Гостиницы и апарт-отели</strong> — мультизональные системы кондиционирования, вентиляция паркингов</li>\n<li><strong>Жилые комплексы</strong> — общеобменная и противодымная вентиляция, интеграция в архитектурные решения</li>\n<li><strong>Частные дома и коттеджи</strong> — скрытый монтаж, интеграция с системами «Умный дом»</li>\n</ul>\n<h2>Руководство и ключевые специалисты</h2>\n<p>За ваш проект отвечают конкретные эксперты с многолетним опытом:</p>\n<div class=\"bf-grid bf-grid-4\">\n<div class=\"team-block-one\">\n<div class=\"inner-box\">\n<div class=\"image\"><img decoding=\"async\" src=\"https://barella.pro/wp-content/uploads/2022/12/team-2-1.png\" alt=\"Кулгин Андрей Анатольевич\"/></div>\n<div class=\"lower-box\">\n<h4>Кулгин Андрей Анатольевич</h4>\n<div class=\"designation\">Генеральный директор.<br />Опыт работы: 13 лет. Стратегия компании, контроль качества и договорных обязательств.</div>\n</div>\n</div>\n</div>\n<div class=\"team-block-one\">\n<div class=\"inner-box\">\n<div class=\"image\"><img decoding=\"async\" src=\"https://barella.pro/wp-content/uploads/2022/12/team-2-3.png\" alt=\"Лабудин Дмитрий\"/></div>\n<div class=\"lower-box\">\n<h4>Лабудин Дмитрий</h4>\n<div class=\"designation\">Заместитель генерального директора.<br />Опыт работы: 15 лет. Операционное управление проектами и сроками.</div>\n</div>\n</div>\n</div>\n<div class=\"team-block-one\">\n<div class=\"inner-box\">\n<div class=\"image\"><img decoding=\"async\" src=\"https://barella.pro/wp-content/uploads/2022/12/team-2-1.png\" alt=\"Фофанков Сергей\"/></div>\n<div class=\"lower-box\">\n<h4>Фофанков Сергей</h4>\n<div class=\"designation\">Главный инженер.<br />Опыт работы: 14 лет. Проектирование систем любой сложности, авторский надзор.</div>\n</div>\n</div>\n</div>\n<div class=\"team-block-one\">\n<div class=\"inner-box\">\n<div class=\"image\"><img decoding=\"async\" src=\"https://barella.pro/wp-content/uploads/2022/12/team-2-3.png\" alt=\"Поздеев Василий\"/></div>\n<div class=\"lower-box\">\n<h4>Поздеев Василий</h4>\n<div class=\"designation\">Руководитель монтажного отдела.<br />Опыт работы: 13 лет. Руководство бригадами, контроль СНиП и техники безопасности.</div>\n</div>\n</div>\n</div>\n</div>\n<h2>Наши принципы работы</h2>\n<p>Мы понимаем, что для бизнеса важны не только технические характеристики, но и прозрачность процессов. Поэтому мы выстроили работу так, чтобы вы были спокойны за результат и бюджет.</p>\n<ul class=\"bf-list bf-check\">\n<li>✔ <strong>Фиксированная смета.</strong> Детально рассчитываем стоимость на этапе проектирования. Цена в договоре не меняется в процессе монтажа — никаких «скрытых доплат».</li>\n<li>✔ <strong>Полный цикл работ.</strong> От выезда инженера и проекта до поставки оборудования, монтажа, пуско-наладки и сдачи объекта в эксплуатацию.</li>\n<li>✔ <strong>Прямые поставки оборудования.</strong> Работаем напрямую с ведущими производителями: оптовые цены и сокращение сроков поставки на 20–30%.</li>\n<li>✔ <strong>Соблюдение сроков.</strong> Фиксируем сроки в договоре и прописываем штрафные санкции за просрочку — мы отвечаем за свои обязательства.</li>\n<li>✔ <strong>Юридическая чистота.</strong> Полный пакет исполнительной документации, помощь с проверками Роспотребнадзора, МЧС, Госстройнадзора.</li>\n<li>✔ <strong>Гарантия качества.</strong> 3 года официальной гарантии на монтажные работы и собственная сервисная служба.</li>\n</ul>\n<div class=\"bf-cta\">\n<h2>Давайте обсудим ваш проект</h2>\n<p>Не знаете, с чего начать? Оставьте заявку, и наш главный инженер бесплатно проконсультирует вас, подскажет оптимальное техническое решение и подготовит предварительную смету.</p>\n\n[contact-form-7 id=\"3334\"]\n</div>\n<p>Контакты офиса: г. Санкт-Петербург, пр-кт Полюстровский, дом 59, лит. А · <a href=\"tel:+79214164646\">+7 (921) 416-46-46</a> · <a href=\"mailto:info@barella.ru\">info@barella.ru</a></p>\n"
    },
